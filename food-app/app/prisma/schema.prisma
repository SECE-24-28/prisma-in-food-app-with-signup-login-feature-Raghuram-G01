generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("users")
}

model FoodItem {
  id       Int    @id @default(autoincrement())
  name     String
  price    Float
  category String
  description String

  @@map("food_items")
}
